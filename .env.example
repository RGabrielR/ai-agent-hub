# Variables de entorno para el Frontend
# Copiar este archivo como .env y completar con tus valores

# ==================== URLs DE BACKEND (Cloud Run) ====================

# URL del servicio Document Processor
# Obtener con: gcloud run services describe rag-document-processor --region us-central1 --format 'value(status.url)'
VITE_DOCUMENT_PROCESSOR_URL=https://rag-document-processor-XXXXXXXXX-uc.a.run.app

# URL del servicio RAG Backend
# Obtener con: gcloud run services describe rag-agent-backend --region us-central1 --format 'value(status.url)'
VITE_RAG_BACKEND_URL=https://rag-agent-backend-XXXXXXXXX-uc.a.run.app

# ==================== GCP ====================

# Project ID de tu proyecto GCP personal
VITE_PROJECT_ID=your-gcp-project-id

# Nombre del bucket de Cloud Storage
VITE_BUCKET_NAME=your-gcp-project-id-rag-documents

# ==================== SEGURIDAD ====================

# Clave compartida entre frontend y backends (misma que BACKEND_API_KEY en Cloud Run)
# Generar con: openssl rand -hex 32
VITE_BACKEND_API_KEY=your-secret-key-here
