# Variables de entorno para Producción - Fábrica de Agentes AI
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env.production
# 2. Despliega los backends en GCP (ver README)
# 3. Reemplaza las URLs XXXXXXXXX con las URLs reales de tus servicios
# 4. Configura estas mismas variables en Vercel Dashboard

# ==================== SERVICIOS BACKEND EN CLOUD RUN ====================

# URL del servicio Document Processor en Cloud Run
# Obtener con: gcloud run services describe rag-document-processor --region us-central1 --format 'value(status.url)'
VITE_DOCUMENT_PROCESSOR_URL=https://rag-document-processor-XXXXXXXXX-uc.a.run.app

# URL del servicio RAG Backend en Cloud Run
# Obtener con: gcloud run services describe rag-agent-backend --region us-central1 --format 'value(status.url)'
VITE_RAG_BACKEND_URL=https://rag-agent-backend-XXXXXXXXX-uc.a.run.app

# ==================== CONFIGURACIÓN DE GCP ====================

# Project ID de Google Cloud Platform
VITE_PROJECT_ID=your-gcp-project-id

# Nombre del bucket de Cloud Storage para documentos
VITE_BUCKET_NAME=your-project-rag-documents

# ==================== NOTAS ====================
#
# Desarrollo local:
# - Para desarrollo local, usa .env con localhost:8080
#
# Producción (Vercel):
# - Configura estas variables en Vercel Dashboard > Settings > Environment Variables
# - O usa: vercel env add VITE_DOCUMENT_PROCESSOR_URL production
#
# Verificar despliegue:
# - Document Processor: curl <VITE_DOCUMENT_PROCESSOR_URL>/health
# - RAG Backend: curl <VITE_RAG_BACKEND_URL>/health
#
